generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  campaigns Campaign[]
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  system      String          @default("D&D 5e")
  status      CampaignStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  players    Player[]
  notes      Note[]
  sessions   Session[]
  characters Character[]
}

model Player {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt   DateTime       @updatedAt

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  character Character?
}

model Note {
  id        String   @id @default(cuid())
  title     String?
  content   String
  type      NoteType @default(PLANNING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
}

model Session {
  id          String   @id @default(cuid())
  title       String
  sessionDate DateTime
  duration    Int
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Character {
  id          String          @id @default(cuid())
  name        String
  description String?
  type        CharacterType
  status      CharacterStatus @default(ALIVE)
  imageUrl    String

  notes Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playerId String? @unique
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  FINISHED
}

enum CharacterStatus {
  ALIVE
  DEAD
  UNKNOWN
}

enum CharacterType {
  PC
  NPC
}

enum NoteType {
  PLANNING
  LORE
  NPC
}
